# LLM providers
GROQ_API_KEY=your_groq_api_key
GOOGLE_API_KEY=your_google_api_key

# Database (dev: sqlite; prod via docker-compose: postgresql+psycopg://procure:procure@postgres:5432/procure)
DATABASE_URL=sqlite:///./procure_guard.db

# MCP ERP
# Dev lokal: localhost. Docker compose meng-override ke http://mcp-server:8001/mcp.
ERP_MCP_URL=http://localhost:8001/mcp
ERP_MCP_TRANSPORT=http

# Governance
APPROVAL_THRESHOLD=50000000.0

# Scheduler (menit)
SCAN_INTERVAL_MINUTES=60
